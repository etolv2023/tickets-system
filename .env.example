APP_NAME="نظام التذاكر"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_EG

# Timestamps are stored in UTC and rendered in Cairo time. PLAN.md § 8
APP_TIMEZONE=UTC
APP_DISPLAY_TIMEZONE=Africa/Cairo

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=etolv_jira
DB_USERNAME=root
DB_PASSWORD=

# file, not database: the install wizard points DB_DATABASE at a brand-new empty
# schema at step 2, and a database-backed session or cache would then fail to
# load on the very next request — before migrations have had a chance to run.
SESSION_DRIVER=file
# Minutes of inactivity before the session dies. F00.2
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# Left unset on purpose: Symfony turns the Secure flag on automatically for any
# HTTPS request, and leaving it hard-true would lock out plain-HTTP local dev.
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# The queue is never touched during install, and its table exists by the time
# the first job is dispatched (F02).
QUEUE_CONNECTION=database

CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@etolv.net"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
