APP_NAME="نظام التذاكر"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Only needed if this copy is reached through a path like
# http://host/some-folder/public/ — several apps sharing one server, each in
# its own subdirectory — rather than owning the domain (or subdomain) root.
# Set it to that exact URL (matching APP_URL's host + the subdirectory) and
# pass the same value as BASE_URL to deploy/build-release.sh so the self-hosted
# fonts' @font-face paths get built with the right prefix baked in — see that
# script's header for why a plain rebuild alone does not fix this.
# ASSET_URL=http://host/some-folder/public

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_EG

# Timestamps are stored in UTC and rendered in Cairo time. PLAN.md § 8
APP_TIMEZONE=UTC
APP_DISPLAY_TIMEZONE=Africa/Cairo

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=etolv_jira
DB_USERNAME=root
DB_PASSWORD=

# file, not database: the install wizard points DB_DATABASE at a brand-new empty
# schema at step 2, and a database-backed session or cache would then fail to
# load on the very next request — before migrations have had a chance to run.
SESSION_DRIVER=file
# Minutes of inactivity before the session dies. F00.2
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# Left unset on purpose: Symfony turns the Secure flag on automatically for any
# HTTPS request, and leaving it hard-true would lock out plain-HTTP local dev.
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# The queue is never touched during install, and its table exists by the time
# the first job is dispatched (F02).
QUEUE_CONNECTION=database

CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@etolv.net"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Virus scanning for portal uploads (F24). Needs a clamd daemon.
# While false, the portal accepts images only.
CLAMAV_ENABLED=false
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_STRICT=true

# F20.2 — إشعارات المتصفح (Web Push). ولّد مفاتيحك بـ: php artisan push:vapid
# فاضيين = الـ push مقفول، والجرس داخل الصفحة بيفضل شغال لوحده.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# تكامل ديسكورد — إشعارات التذاكر (القناة العامة + رسايل خاصة للمسؤولين)
# مقفول افتراضياً. من غير توكن أو قناة النظام بيشتغل زي ما هو من غير أي نداء لديسكورد.
# البوت REST بس — مش محتاج أي intents.
DISCORD_ENABLED=false
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# في وضع الفوروم ده لازم يكون Forum Channel (نوع 15)، والنظام بيفتح جواه بوست
# لكل يوم شغل وبيحط تذاكر اليوم كلها فيه.
DISCORD_TICKETS_CHANNEL_ID=
# تجميع التذاكر في بوست لكل يوم جوه الفوروم. false = رجوع للقناة النصية
# العادية بثريد لكل تذكرة (مسار التراجع).
DISCORD_FORUM_MODE=true
# طابور مستقل عن طابور النظام، عشان بطء ديسكورد أو الـ rate limit ميعطّلش
# باقي الشغل. نفس الاتصال ونفس جدول jobs — الاسم بس هو اللي مختلف.
# لازم عامل تاني: php artisan queue:work --queue=discord
DISCORD_QUEUE=discord
# DISCORD_USE_THREADS=true          تحديثات التذكرة في ثريد تحت رسالتها الأصلية
# DISCORD_ANNOUNCE_STATUS=true      إعلان تغيير الحالة في ثريد التذكرة
# DISCORD_MENTION_ASSIGNEES=false   منشن في القناة العامة (الـ DM أصلاً بيوصلهم)
# DISCORD_DRY_RUN=false             يكتب الرسالة في اللوج من غير ما يبعتها فعلاً
# DISCORD_TIMEOUT=10
# DISCORD_RECLAIM_AFTER=120         ثواني قبل ما صف عالق يتاخد تاني (مع بحث بالـ nonce)
# DISCORD_RECOVERY_MAX_AGE=3600     بعدها الصف الغامض يتعلّم unverified ومبيتبعتش تاني
